{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DylanMerigaud/ucits-etf-issuer-holdings/blob/main/schema/fund.schema.json",
  "title": "Fund",
  "description": "The holdings an issuer publishes for one UCITS ETF, as returned by ucits-etf-issuer-holdings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["isin", "issuer", "fund_name", "as_of", "currency", "source_url", "fetched_at", "stale", "holdings"],
  "properties": {
    "isin": { "type": "string", "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$" },
    "issuer": { "enum": ["ishares", "vanguard", "spdr", "xtrackers", "amundi", "invesco"] },
    "fund_name": { "type": ["string", "null"] },
    "as_of": {
      "description": "Date of the holdings, YYYY-MM-DD, or null when the issuer does not give one.",
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "currency": { "type": ["string", "null"] },
    "source_url": { "type": "string" },
    "fetched_at": {
      "description": "ISO 8601 UTC time the data was fetched from the issuer: for an answer served from the cache, the time it was stored; when several answers were used, the oldest.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "stale": {
      "description": "True when the data comes from the cache because the issuer could not be reached.",
      "type": "boolean"
    },
    "holdings": { "type": "array", "items": { "$ref": "#/$defs/holding" } }
  },
  "$defs": {
    "holding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "weight", "isin", "ticker", "country", "country_name", "sector", "currency", "asset_class", "asset_class_raw"],
      "properties": {
        "name": { "type": "string" },
        "weight": { "description": "Percent of the fund.", "type": "number" },
        "isin": { "type": ["string", "null"] },
        "ticker": { "type": ["string", "null"] },
        "country": { "description": "ISO 3166-1 alpha-2.", "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
        "country_name": { "type": ["string", "null"] },
        "sector": { "type": ["string", "null"] },
        "currency": { "type": ["string", "null"] },
        "asset_class": {
          "description": "The asset class mapped to one vocabulary, null when the issuer gives none; a label the library does not know is other.",
          "enum": ["equity", "fixed_income", "cash", "derivative", "fund", "real_estate", "commodity", "other", null]
        },
        "asset_class_raw": {
          "description": "The issuer's own asset class label, as published.",
          "type": ["string", "null"]
        }
      }
    }
  }
}
