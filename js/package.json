{
  "name": "ucits-etf-issuer-holdings",
  "version": "0.1.0",
  "description": "Full holdings of a UCITS ETF by ISIN, read from the issuer's own published files (iShares, Vanguard, Xtrackers, Amundi, SPDR, Invesco).",
  "type": "module",
  "license": "MIT",
  "author": "Dylan Merigaud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DylanMerigaud/ucits-etf-issuer-holdings.git",
    "directory": "js"
  },
  "homepage": "https://github.com/DylanMerigaud/ucits-etf-issuer-holdings#readme",
  "bugs": {
    "url": "https://github.com/DylanMerigaud/ucits-etf-issuer-holdings/issues"
  },
  "keywords": [
    "etf",
    "ucits",
    "holdings",
    "isin",
    "look-through",
    "ishares",
    "vanguard",
    "xtrackers",
    "amundi",
    "spdr",
    "invesco",
    "portfolio"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "bin": {
    "ucits-holdings": "dist/cli.js"
  },
  "files": [
    "dist",
    "recorded",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/copy-recorded.mjs && tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test dist-test/*.test.js",
    "test:live": "npm run build:test && node --test dist-test/live.contract.js",
    "snapshot": "node scripts/python-snapshot.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  }
}
